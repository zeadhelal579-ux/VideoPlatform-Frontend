# Demo build: the whole site runs WITHOUT a backend (a fake Api lives inside the browser).
# Vite loads this file automatically for "npm run build" / Vercel, so nothing needs to be set in the Vercel dashboard.
#
# TO USE A REAL BACKEND LATER: delete this file (or change the value to false), then follow README.md ("Choose how the browser reaches the Api").
VITE_DEMO_MODE=true
